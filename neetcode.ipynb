        "#Contains Duplicate\n",
        "\n",
        "nums = [1, 2, 3, 4]\n",
        "num1=nums\n",
        "num=[]\n",
        "for i in nums:\n",
        "  if i not in num:\n",
        "    num.append(i)\n",
        "    if  num1==num:\n",
        "      print(False)\n",
        "    else:\n",
        "      print(True)\n",
        "\n"
